---
import atlasLogo from '../../imagens_mockup/atlasLogoPrincipal.png';
---

<footer class="site-footer">
    <div class="footer-glow" aria-hidden="true"></div>

    <div class="footer-container">
        <div class="footer-main">
            <div class="footer-brand">
                <a class="footer-logo" href="/#home" aria-label="Atlas, início">
                    <img class="footer-logo-image" src={atlasLogo.src} alt="Atlas" />
                </a>
                <p>Leia mais. Viva melhor.</p>
            </div>

            <div class="footer-column">
                <h3>Explorar</h3>
                <a href="/#home">Início</a>
                <a href="/#resources">Recursos</a>
                <a href="/#check-in">Como funciona</a>
                    <a href="/#waitlist">Lista de espera</a>
            </div>

            <div class="footer-column">
                <h3>Suporte</h3>
                <a href="/#faq">Perguntas frequentes</a>
                <a href="mailto:contato@atlas.app">Fale conosco</a>
                <a href="/#faq">Central de ajuda</a>
                <a href="mailto:suporte@atlas.app">Reportar um problema</a>
            </div>

            <div class="footer-cta">
                <span class="footer-cta-label">SUA PRÓXIMA PÁGINA COMEÇA AQUI</span>
                <h2>Pronto para criar um novo hábito?</h2>
                <a class="footer-cta-button" href="/#waitlist">Avise-me no lançamento <span aria-hidden="true">→</span></a>
            </div>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-bottom">
            <p>© 2026 Atlas. Todos os direitos reservados.</p>
            <div class="footer-legal">
                <a href="/politica-de-privacidade">Política de Privacidade</a>
                <a href="/termos-de-uso">Termos de Uso</a>
            </div>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        position: relative;
        overflow: hidden;
        border-top: 1px solid rgba(137, 169, 199, .13);
        background: #070c11;
        color: #f4f7fb;
    }

    .footer-glow {
        position: absolute;
        top: -180px;
        left: 14%;
        width: 420px;
        height: 260px;
        border-radius: 50%;
        background: rgba(20, 126, 224, .08);
        filter: blur(70px);
        pointer-events: none;
    }

    .footer-container {
        position: relative;
        z-index: 1;
        width: min(1380px, calc(100% - 6rem));
        margin: 0 auto;
    }

    .footer-main {
        display: grid;
        grid-template-columns: 1.25fr .75fr .95fr 1.45fr;
        gap: 3rem;
        padding: 5.2rem 0 4.5rem;
    }

    .footer-brand { align-self: start; }

    .footer-logo { display: inline-flex; align-items: center; width: 210px; transition: transform .2s ease; }
    .footer-logo:hover { transform: translateY(-2px); }
    .footer-logo-image { display: block; width: 100%; height: auto; object-fit: contain; }

    .footer-brand > p {
        margin: 1.25rem 0 1.3rem;
        color: #a9bdd0;
        font-size: 1rem;
    }

    .footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: .85rem; }
    .footer-column h3 { margin: .25rem 0 .6rem; color: #f4f7fb; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .footer-column a { color: #8fa6ba; font-size: .92rem; transition: color .2s ease, transform .2s ease; }
    .footer-column a:hover { color: #fff; transform: translateX(3px); }

    .footer-cta {
        align-self: start;
        padding: 1.5rem 1.6rem 1.55rem;
        border: 1px solid rgba(83, 151, 211, .25);
        border-radius: 18px;
        background: linear-gradient(145deg, rgba(17, 36, 53, .76), rgba(10, 18, 26, .72));
        box-shadow: inset 0 1px rgba(255,255,255,.05), 0 18px 35px rgba(0,0,0,.13);
    }

    .footer-cta-label { color: #3b9df2; font-size: .65rem; font-weight: 700; letter-spacing: .16em; }
    .footer-cta h2 { max-width: 260px; margin: .7rem 0 1.3rem; color: #f7f9fc; font-size: 1.55rem; line-height: 1.15; letter-spacing: -.045em; }
    .footer-cta-button { display: inline-flex; align-items: center; gap: .7rem; padding: .7rem 1rem; border-radius: 99px; color: #fff; background: #1289f2; font-size: .82rem; font-weight: 700; transition: transform .2s ease, background .2s ease; }
    .footer-cta-button span { font-size: 1rem; transition: transform .2s ease; }
    .footer-cta-button:hover { background: #2598ff; transform: translateY(-2px); }
    .footer-cta-button:hover span { transform: translateX(3px); }

    .footer-divider { height: 1px; background: rgba(137, 169, 199, .13); }
    .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.45rem 0 1.6rem; color: #71879b; font-size: .76rem; }
    .footer-bottom p { margin: 0; }
    .footer-legal { display: flex; gap: 1.5rem; }
    .footer-legal a { color: #71879b; transition: color .2s ease; }
    .footer-legal a:hover { color: #f4f7fb; }

    @media (max-width: 1050px) {
        .footer-container { width: min(920px, calc(100% - 3rem)); }
        .footer-main { grid-template-columns: 1fr 1fr 1.25fr; gap: 2.5rem 2rem; }
        .footer-brand { grid-row: span 2; }
        .footer-cta { grid-column: 2 / -1; }
    }

    @media (max-width: 640px) {
        .footer-container { width: calc(100% - 2rem); }
        .footer-main { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; padding: 3.8rem 0 3.2rem; }
        .footer-brand { grid-column: 1 / -1; grid-row: auto; }
        .footer-cta { grid-column: 1 / -1; }
        .footer-bottom { flex-direction: column; align-items: flex-start; gap: .8rem; padding-bottom: 1.8rem; }
        .footer-legal { order: -1; gap: 1rem; }
    }

    @media (max-width: 390px) {
        .footer-main { grid-template-columns: 1fr; }
        .footer-column { gap: .7rem; }
    }
</style>
