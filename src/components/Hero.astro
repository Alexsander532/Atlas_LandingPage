---
---

<section id="home" class="hero" aria-labelledby="hero-title">
    <div class="hero-haze hero-haze--left"></div>
    <div class="hero-haze hero-haze--right"></div>

    <div class="hero-container">
        <div class="hero-copy">
            <p class="hero-eyebrow">LEITURA SEMPRE COM VOCÊ</p>
            <h1 id="hero-title" class="hero-title">
                <span>Atlas:</span>
                <span>Leia mais,</span>
                <span class="hero-title-accent">viva melhor.</span>
            </h1>
            <p class="hero-description">
                Crie o hábito da leitura com check-ins,<br class="desktop-only" />
                desafios e uma comunidade que te inspira.
            </p>

            <div class="store-buttons" aria-label="Baixe o aplicativo">
                <a class="store-button" href="#resources" aria-label="Baixar na App Store">
                    <svg class="store-icon apple-icon" viewBox="0 0 24 29" aria-hidden="true">
                        <path d="M19.9 15.5c0-3.4 2.8-5.1 2.9-5.2-1.6-2.3-4-2.6-4.9-2.7-2.1-.2-4.1 1.2-5.2 1.2-1.1 0-2.8-1.2-4.6-1.1-2.4 0-4.5 1.4-5.7 3.5-2.5 4.3-.6 10.7 1.8 14.2 1.2 1.7 2.6 3.6 4.5 3.5 1.8-.1 2.5-1.1 4.7-1.1s2.8 1.1 4.7 1.1c2 0 3.2-1.7 4.4-3.4 1.4-2 2-4 2.1-4.1-.1 0-4.7-1.8-4.7-5.9ZM16.5 5.4c.9-1.1 1.6-2.6 1.4-4.1-1.3.1-2.9.9-3.8 2-.8.9-1.5 2.5-1.3 3.9 1.5.1 2.9-.7 3.7-1.8Z" />
                    </svg>
                    <span><small>Baixar na</small><strong>App Store</strong></span>
                </a>
                <a class="store-button" href="#resources" aria-label="Baixar no Google Play">
                    <svg class="store-icon play-icon" viewBox="0 0 32 32" aria-hidden="true">
                        <path fill="#22d66b" d="M3.05 1.55C2.35 2.2 2 3.2 2 4.45v23.1c0 1.25.35 2.25 1.05 2.9L17.15 16 3.05 1.55Z" />
                        <path fill="#ffda2d" d="m20.7 12.35-4.05 3.65L3.05 1.55c.48-.43 1.08-.66 1.8-.7.4-.02.82.1 1.25.35l14.6 11.15Z" />
                        <path fill="#ff5b5b" d="M28.15 13.9 20.7 12.35 16.65 16l4.05 3.65 7.45-1.55c2.46-.52 2.46-3.68 0-4.2Z" />
                        <path fill="#31a7ff" d="m3.05 30.45 13.6-14.45 4.05 3.65L6.1 31.15c-.43.25-.85.37-1.25.35-.72-.04-1.32-.27-1.8-.7l0-.35Z" />
                    </svg>
                    <span><small>Baixar no</small><strong>Google Play</strong></span>
                </a>
            </div>

            <div class="hero-points" aria-label="Benefícios do Atlas">
                <div class="hero-point">
                    <span class="point-icon point-icon--blue">
                        <svg viewBox="0 0 24 28" aria-hidden="true"><path d="m14.7 1-11 14.1h7.1L9.3 27 20.5 11h-7.2L14.7 1Z" /></svg>
                    </span>
                    <span>Crie o hábito</span>
                </div>
                <div class="hero-point">
                    <span class="point-icon point-icon--green">
                        <svg viewBox="0 0 32 24" aria-hidden="true"><circle cx="16" cy="7" r="5" /><circle cx="5.5" cy="9" r="4" /><circle cx="26.5" cy="9" r="4" /><path d="M7 22c0-5 3.5-8 9-8s9 3 9 8M0 22c.2-4.2 2-6.3 5.5-6.3 1.2 0 2.2.2 3 .7M32 22c-.2-4.2-2-6.3-5.5-6.3-1.2 0-2.2.2-3 .7" /></svg>
                    </span>
                    <span>Conecte-se</span>
                </div>
                <div class="hero-point">
                    <span class="point-icon point-icon--purple">
                        <svg viewBox="0 0 28 29" aria-hidden="true"><path d="M8 3h12v9c0 3.8-2.7 6.5-6 6.5S8 15.8 8 12V3Z" /><path d="M8 6H3v3c0 3.5 2 5.3 5.5 5.5M20 6h5v3c0 3.5-2 5.3-5.5 5.5M14 18.5V24M9 27h10" /></svg>
                    </span>
                    <span>Evolua</span>
                </div>
            </div>
        </div>

        <div class="hero-visual" aria-label="Prévia do aplicativo Atlas">
            <div class="hero-note" aria-hidden="true">
                <span>Pequenas</span>
                <span>leituras,</span>
                <span>grandes</span>
                <span>histórias!</span>
                <svg viewBox="0 0 150 34"><path d="M5 27c40-21 92-27 143-23" /></svg>
            </div>

            <img class="hero-table" src="/images/hero/MesamadeiraHero.png" alt="" aria-hidden="true" />

            <div class="phone-stack">
                <div class="phone phone--back">
                <img src="/images/hero/tela-comunidade-hero.png" alt="Tela Comunidade do aplicativo Atlas" />
                <div class="phone-shell">
                    <div class="phone-screen phone-screen--community">
                        <div class="status-bar"><span>9:41</span><span>▮▮▮ ◔ ▰</span></div>
                        <div class="community-heading"><strong>Comunidade</strong><span>⌁</span></div>
                        <div class="community-tabs"><span class="is-active">Todos</span><span>Amigos</span><span>Clubes</span></div>
                        <div class="community-list">
                            <div class="community-row"><span class="avatar avatar--mariana">M</span><span><b>Mariana</b><small>Leu por 42 minutos<br /><em>há 2h</em></small></span><strong>▣</strong></div>
                            <div class="community-row"><span class="avatar avatar--lucas">L</span><span><b>Lucas</b><small>Terminou o capítulo 4<br /><em>de Duna · há 3h</em></small></span><strong>▤</strong></div>
                            <div class="community-row"><span class="avatar avatar--sofia">S</span><span><b>Sofia</b><small>Iniciou uma sessão<br /><em>de 30 minutos · há 5h</em></small></span><strong>♨</strong></div>
                            <div class="community-row"><span class="avatar avatar--pedro">P</span><span><b>Pedro</b><small>Concluiu<br /><em>Hábitos Atômicos · há 1d</em></small></span><strong>▣</strong></div>
                        </div>
                        <div class="phone-nav"><span>⌂<small>Início</small></span><span>⌕<small>Explorar</small></span><span class="active">♟<small>Comunidade</small></span><span>♙<small>Perfil</small></span></div>
                    </div>
                </div>
            </div>

                <div class="phone phone--front">
                <img src="/images/hero/tela-inicial-hero.png" alt="Tela inicial do aplicativo Atlas" />
                <div class="phone-shell">
                    <div class="phone-screen phone-screen--home">
                        <div class="status-bar"><span>9:41</span><span>▮▮▮ ◔ ▰</span></div>
                        <div class="home-heading"><span class="profile-avatar">●</span><span><small>Olá, Alex</small><b>Bora ler hoje?</b></span><strong>⚙</strong></div>
                        <div class="streak-card"><span class="fire">♨</span><span><small>Sequência atual</small><b>7 dias</b></span><strong>›</strong></div>
                        <div class="timer-ring"><span><b>25</b><small>minutos</small></span></div>
                        <button class="start-reading"><span>▶</span> Iniciar leitura</button>
                        <div class="daily-card"><span><small>Meta diária</small><b>25 / 30 min</b></span><strong>83%</strong><i><em></em></i></div>
                        <div class="book-card"><span class="book-cover">DUNE</span><span><small>Livro atual</small><b>Duna</b><em>Frank Herbert</em></span><strong>38%<i><em></em></i></strong></div>
                        <div class="phone-nav"><span class="active">⌂<small>Início</small></span><span>⌕<small>Explorar</small></span><span>♟<small>Comunidade</small></span><span>♙<small>Perfil</small></span></div>
                    </div>
                </div>
                </div>
            </div>

            <div class="bear-scene" aria-hidden="true">
                <img src="/images/hero/imagemHeroUrso.png" alt="" />
            </div>

            <img class="hero-plant" src="/images/hero/PlantaDesfocadaHero.png" alt="" aria-hidden="true" />
        </div>
    </div>

</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        color: #f7f8fb;
        background:
            radial-gradient(circle at 68% 74%, rgba(27, 61, 88, .22), transparent 25rem),
            radial-gradient(circle at 26% 31%, rgba(19, 51, 81, .2), transparent 15rem),
            linear-gradient(115deg, #091017 0%, #080d12 48%, #05080b 100%);
    }

    .hero::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(4, 8, 11, .05), transparent 55%, rgba(0, 0, 0, .24));
    }

    .hero-haze {
        position: absolute;
        border-radius: 50%;
        filter: blur(2px);
        pointer-events: none;
    }

    .hero-haze--left { width: 150px; height: 150px; left: 28%; top: 20%; background: rgba(20, 66, 107, .12); box-shadow: 0 0 55px 20px rgba(16, 75, 126, .1); }
    .hero-haze--right { width: 220px; height: 220px; right: -30px; bottom: -60px; background: rgba(54, 102, 20, .1); box-shadow: 0 0 60px 20px rgba(40, 95, 20, .12); }

    .hero-container {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(410px, .82fr) minmax(680px, 1.38fr);
        align-items: center;
        gap: 1rem;
        width: min(1380px, calc(100% - 10rem));
        min-height: 100vh;
        margin: 0 auto;
        padding-top: 7.4rem;
        padding-bottom: 3rem;
    }

    .hero-copy { position: relative; z-index: 5; align-self: center; padding-top: 1.7rem; }
    .hero-eyebrow { margin-bottom: 1.45rem; color: #aebaca; font-size: .9rem; font-weight: 500; letter-spacing: .27em; animation: hero-fade-up .7s cubic-bezier(.22, 1, .36, 1) .08s both; }
    .hero-title { margin: 0; font-size: clamp(4rem, 5.65vw, 5.65rem); font-weight: 800; line-height: .97; letter-spacing: -.065em; animation: hero-title-in .9s cubic-bezier(.22, 1, .36, 1) .16s both; }
    .hero-title span { display: block; }
    .hero-title-accent { color: #1495fa; text-shadow: 0 0 32px rgba(17, 132, 238, .16); }
    .hero-description { margin: 1.55rem 0 2.55rem; color: #b7c9dd; font-size: 1.28rem; line-height: 1.45; letter-spacing: -.02em; animation: hero-fade-up .75s cubic-bezier(.22, 1, .36, 1) .3s both; }

    .store-buttons { display: flex; gap: 1.25rem; animation: hero-fade-up .75s cubic-bezier(.22, 1, .36, 1) .44s both; }
    .store-button { display: flex; align-items: center; gap: .95rem; width: 214px; min-height: 76px; padding: .8rem 1.25rem; border: 1px solid rgba(164, 190, 215, .22); border-radius: 16px; background: linear-gradient(145deg, rgba(25, 34, 42, .68), rgba(8, 13, 18, .8)); box-shadow: inset 0 1px rgba(255,255,255,.07), 0 9px 20px rgba(0,0,0,.16); transition: transform .25s ease, border-color .25s ease, background .25s ease; }
    .store-button:hover { transform: translateY(-3px); border-color: rgba(61, 156, 255, .75); background: rgba(22, 38, 53, .88); }
    .store-icon { width: 30px; max-height: 34px; flex: 0 0 auto; fill: #fff; animation: hero-icon-pop .7s cubic-bezier(.22, 1, .36, 1) .58s both; }
    .store-button:nth-child(2) .store-icon { animation-delay: .7s; }
    .store-button span { display: flex; flex-direction: column; line-height: 1.04; }
    .store-button > span { animation: hero-label-in .65s cubic-bezier(.22, 1, .36, 1) .64s both; }
    .store-button:nth-child(2) > span { animation-delay: .76s; }
    .store-button small { color: #f3f5f8; font-size: .72rem; font-weight: 400; }
    .store-button strong { margin-top: .24rem; color: #fff; font-size: 1.18rem; font-weight: 600; letter-spacing: -.03em; }

    .hero-points { display: flex; gap: 3.9rem; margin-top: 4.55rem; animation: hero-fade-up .8s cubic-bezier(.22, 1, .36, 1) .58s both; }
    .hero-point { display: flex; flex-direction: column; align-items: center; gap: .75rem; color: #f8fafc; font-size: .98rem; white-space: nowrap; animation: hero-point-in .7s cubic-bezier(.22, 1, .36, 1) .72s both; }
    .hero-point:nth-child(2) { animation-delay: .82s; }
    .hero-point:nth-child(3) { animation-delay: .92s; }
    .point-icon { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; animation: hero-icon-pop .7s cubic-bezier(.22, 1, .36, 1) .8s both; }
    .hero-point:nth-child(2) .point-icon { animation-delay: .9s; }
    .hero-point:nth-child(3) .point-icon { animation-delay: 1s; }
    .hero-point > span:last-child { animation: hero-label-in .6s cubic-bezier(.22, 1, .36, 1) .9s both; }
    .hero-point:nth-child(2) > span:last-child { animation-delay: 1s; }
    .hero-point:nth-child(3) > span:last-child { animation-delay: 1.1s; }
    .point-icon svg { width: 27px; height: 27px; fill: none; stroke: currentColor; stroke-width: 2.2; }
    .point-icon--blue { color: #1598ff; background: #062345; }
    .point-icon--blue svg { fill: currentColor; stroke: none; }
    .point-icon--green { color: #38d761; background: #052d19; }
    .point-icon--green svg { fill: none; }
    .point-icon--purple { color: #c781ff; background: #200939; }

    /* One proportional scene keeps every object resting on the same tabletop. */
    .hero-visual { position: relative; isolation: isolate; container-type: inline-size; width: 100%; min-height: 0; aspect-ratio: 900 / 870; align-self: center; }
    .hero-visual::before { display: none; }
    .hero-visual::after { content: ''; position: absolute; z-index: 0; right: 7%; bottom: 7%; width: 77%; height: 14%; border-radius: 50%; background: radial-gradient(ellipse, rgba(0,0,0,.82), rgba(0,0,0,0) 70%); filter: blur(10px); }
    .hero-table { position: absolute; z-index: 0; left: -27%; top: 42%; width: 150%; max-width: none; height: auto; pointer-events: none; animation: hero-table-in 1.1s cubic-bezier(.22, 1, .36, 1) .15s both; }
    .hero-note { position: absolute; z-index: 4; top: 9%; right: -2%; display: flex; flex-direction: column; color: #a5b5cb; font-family: 'Comic Sans MS', 'Bradley Hand', cursive; font-size: 3.2cqw; font-weight: 600; line-height: 1.05; letter-spacing: .02em; transform: rotate(-12deg); text-shadow: 0 2px 9px rgba(0,0,0,.35); animation: hero-note-in .8s cubic-bezier(.22, 1, .36, 1) .4s both; }
    .hero-note span:nth-child(2) { margin-left: 1cqw; }
    .hero-note span:nth-child(3) { margin-left: 2.2cqw; }
    .hero-note span:nth-child(4) { margin-left: 2.9cqw; }
    .hero-note svg { width: 17cqw; margin: 1cqw 0 0 3cqw; overflow: visible; }
    .hero-note path { fill: none; stroke: #168dff; stroke-width: 4; }

    .phone-stack { position: absolute; z-index: 2; inset: 0; transform: translateX(3%); }
    .phone-stack::after { content: ''; position: absolute; z-index: 0; left: 25%; bottom: 7%; width: 58%; height: 8%; border-radius: 50%; background: rgba(0,0,0,.72); filter: blur(16px); pointer-events: none; }
    .phone { position: absolute; transform-origin: center bottom; filter: drop-shadow(0 30px 30px rgba(0,0,0,.55)); }
    .phone > img { display: block; width: 100%; height: 100%; object-fit: fill; }
    .phone--back { z-index: 1; bottom: 13%; left: 7%; width: 38%; aspect-ratio: 1 / 2; transform: rotate(-5deg); animation: phone-back-in .95s cubic-bezier(.22, 1, .36, 1) .5s both; }
    .phone--front { z-index: 2; bottom: 8%; left: 35%; width: 38%; aspect-ratio: 1 / 2; transform: rotate(2deg); animation: phone-front-in .95s cubic-bezier(.22, 1, .36, 1) .68s both; }
    .phone-shell { display: none; width: 100%; height: 100%; padding: 12px; border: 2px solid #72869b; border-radius: 48px; background: linear-gradient(132deg, #16202b, #05080c 32%, #0b1117 80%, #263b4c); box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), 0 0 15px rgba(76, 161, 244, .22); }
    .phone-screen { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid rgba(255,255,255,.08); border-radius: 37px; background: #071019; color: #f3f7fc; box-shadow: inset 0 0 55px rgba(25, 83, 125, .1); }
    .phone-screen::before { content: ''; position: absolute; z-index: 6; top: 0; left: 50%; width: 125px; height: 27px; border-radius: 0 0 17px 17px; background: #010204; transform: translateX(-50%); }
    .status-bar { display: flex; justify-content: space-between; padding: 1.2rem 1.15rem .3rem; font-size: .7rem; font-weight: 700; }
    .phone--front .status-bar { padding-top: 1.35rem; }

    .community-heading { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem .85rem; font-size: 1.1rem; }
    .community-heading span { color: #94aac1; font-size: 1.5rem; }
    .community-tabs { display: flex; gap: .25rem; margin: 0 .75rem .7rem; padding: .3rem; border-radius: 99px; background: rgba(109, 139, 163, .14); }
    .community-tabs span { flex: 1; padding: .55rem .25rem; border-radius: 99px; color: #8ea4ba; font-size: .68rem; text-align: center; }
    .community-tabs .is-active { color: #05111b; background: #1599ff; font-weight: 700; }
    .community-list { padding: .2rem .8rem 0; }
    .community-row { display: grid; grid-template-columns: 36px 1fr 20px; gap: .65rem; align-items: center; min-height: 104px; border-bottom: 1px solid rgba(160, 188, 215, .1); }
    .community-row > span:nth-child(2) { min-width: 0; }
    .community-row b, .community-row small { display: block; }
    .community-row b { margin-bottom: .28rem; font-size: .77rem; }
    .community-row small { color: #bdc9d5; font-size: .68rem; line-height: 1.3; }
    .community-row em { color: #738ba1; font-style: normal; font-size: .62rem; }
    .community-row > strong { color: #1a9aff; font-size: 1.1rem; }
    .avatar { display: grid; place-items: center; width: 34px; height: 34px; overflow: hidden; border: 2px solid #e9f1f9; border-radius: 50%; color: #152231; font-size: .75rem; font-weight: 800; }
    .avatar--mariana { background: linear-gradient(140deg, #f3c1a3, #735349); }
    .avatar--lucas { background: linear-gradient(140deg, #94b5d2, #344e63); }
    .avatar--sofia { background: linear-gradient(140deg, #f0d0af, #7d573b); }
    .avatar--pedro { background: linear-gradient(140deg, #a2c8e6, #36536c); }

    .home-heading { display: grid; grid-template-columns: 45px 1fr 30px; gap: .65rem; align-items: center; padding: 1.15rem 1.25rem 1rem; }
    .profile-avatar { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: #6d432a; background: radial-gradient(circle at 50% 38%, #f4b978 0 22%, #754629 23% 29%, #a9693c 30% 100%); box-shadow: inset 0 0 0 2px #d5a16a; font-size: 0; }
    .home-heading small, .home-heading b { display: block; }
    .home-heading small { margin-bottom: .2rem; color: #f4f6f9; font-size: 1.08rem; font-weight: 600; }
    .home-heading b { color: #9dafc3; font-size: .75rem; font-weight: 400; }
    .home-heading > strong { color: #bdd1e5; font-size: 1.35rem; }
    .streak-card { display: grid; grid-template-columns: 48px 1fr 25px; gap: .65rem; align-items: center; margin: .4rem .9rem 1rem; padding: .85rem .85rem; border-radius: 15px; background: linear-gradient(135deg, #16232e, #121c26); box-shadow: inset 0 1px rgba(255,255,255,.04); }
    .fire { display: grid; place-items: center; width: 38px; height: 38px; color: #ff7043; font-size: 2rem; }
    .streak-card small, .streak-card b { display: block; }
    .streak-card small { color: #b9c8d7; font-size: .7rem; }
    .streak-card b { margin-top: .25rem; font-size: 1rem; }
    .streak-card > strong { color: #b7c9d9; font-size: 2rem; font-weight: 300; }
    .timer-ring { display: grid; place-items: center; width: 164px; height: 164px; margin: .35rem auto 1rem; border-radius: 50%; background: conic-gradient(#1598ff 0 83%, rgba(120, 156, 185, .16) 83% 100%); transform: rotate(-45deg); }
    .timer-ring::before { content: ''; position: absolute; width: 148px; height: 148px; border-radius: 50%; background: #071019; }
    .timer-ring span { position: relative; display: flex; flex-direction: column; align-items: center; transform: rotate(45deg); }
    .timer-ring b { font-size: 2.65rem; line-height: 1; }
    .timer-ring small { margin-top: .35rem; color: #c5d2df; font-size: .75rem; }
    .start-reading { display: flex; align-items: center; justify-content: center; gap: .5rem; width: calc(100% - 4.5rem); margin: 0 auto 1rem; padding: .78rem; border: 0; border-radius: 99px; color: #03101a; background: #1799ff; font: inherit; font-size: .78rem; font-weight: 700; box-shadow: 0 6px 18px rgba(17, 139, 242, .3); }
    .start-reading span { font-size: .6rem; }
    .daily-card, .book-card { margin: 0 .8rem .65rem; padding: .8rem .85rem; border-radius: 13px; background: linear-gradient(135deg, #121e29, #101923); }
    .daily-card { display: grid; grid-template-columns: 1fr auto; gap: .4rem; }
    .daily-card small, .daily-card b { display: block; }
    .daily-card small { color: #c3cfdb; font-size: .66rem; }
    .daily-card b { margin-top: .2rem; font-size: .78rem; font-weight: 500; }
    .daily-card > strong { align-self: center; color: #1598ff; font-size: .7rem; }
    .daily-card i, .book-card i { grid-column: 1 / -1; display: block; height: 7px; margin-top: .35rem; border-radius: 99px; background: #283b4d; }
    .daily-card i em { display: block; width: 83%; height: 100%; border-radius: inherit; background: #1598ff; }
    .book-card { display: grid; grid-template-columns: 42px 1fr 38px; align-items: center; gap: .65rem; }
    .book-cover { display: grid; place-items: center; width: 42px; height: 55px; border-radius: 3px; color: #f6d7a4; background: linear-gradient(145deg, #8a3a2b, #c3663c); font-family: Georgia, serif; font-size: .58rem; }
    .book-card small, .book-card b, .book-card em { display: block; }
