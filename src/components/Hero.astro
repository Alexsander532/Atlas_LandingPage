<script>
    const waitlistForm = document.querySelector('[data-waitlist-form]');

    if (waitlistForm instanceof HTMLFormElement) {
        const emailInput = waitlistForm.querySelector('input[name="email"]');
        const consentInput = waitlistForm.querySelector('input[name="consent"]');
        const honeypotInput = waitlistForm.querySelector('input[name="website"]');
        const submitButton = waitlistForm.querySelector('button[type="submit"]');
        const feedback = waitlistForm.querySelector('[data-waitlist-feedback]');

        if (
            emailInput instanceof HTMLInputElement &&
            consentInput instanceof HTMLInputElement &&
            honeypotInput instanceof HTMLInputElement &&
            submitButton instanceof HTMLButtonElement &&
            feedback instanceof HTMLElement
        ) {
            waitlistForm.addEventListener('submit', async (event) => {
                event.preventDefault();

                if (!emailInput.checkValidity() || !consentInput.checked) {
                    waitlistForm.reportValidity();
                    return;
                }

                feedback.dataset.state = '';
                feedback.textContent = 'Enviando seu cadastro...';
                submitButton.disabled = true;

                try {
                    const response = await fetch('/api/waitlist', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: emailInput.value.trim(),
                            consent: consentInput.checked,
                            website: honeypotInput.value,
                        }),
                    });

                    if (response.status === 409) {
                        feedback.dataset.state = 'info';
                        feedback.textContent = 'Esse e-mail já está na lista. Avisaremos você quando o Atlas chegar.';
                        return;
                    }

                    if (!response.ok) {
                        throw new Error('waitlist_request_failed');
                    }

                    waitlistForm.reset();
                    feedback.dataset.state = 'success';
                    feedback.textContent = 'Cadastro realizado! Avisaremos você quando o Atlas estiver disponível.';
                } catch {
                    feedback.dataset.state = 'error';
                    feedback.textContent = 'Não foi possível concluir agora. Tente novamente em instantes.';
                } finally {
                    submitButton.disabled = false;
                }
            });
        }
    }
</script>
