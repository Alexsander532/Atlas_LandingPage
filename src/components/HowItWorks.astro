---
import checkInPhone from '../../imagens_mockup/3_secao/mockup-check-in-leitura.png';
import rankingPhone from '../../imagens_mockup/3_secao/mockup-ranking-semanal.png';
import chatPhone from '../../imagens_mockup/3_secao/mockup-chat-literario.png';
import companionPhone from '../../imagens_mockup/3_secao/74f2a264-d519-4f81-a68f-ff6ff4bf2bab.png';
---

<section id="check-in" class="checkin-section" aria-labelledby="checkin-title">
    <div class="checkin-container">
        <div class="checkin-copy from-left">
            <span class="checkin-pill"><span aria-hidden="true">📖</span> Check-in Inteligente</span>
            <h2 id="checkin-title">Check-in de Leitura</h2>
            <p class="checkin-description">
                Registre sua leitura diária em poucos segundos<br class="desktop-only" />
                e acompanhe seu progresso automaticamente.
            </p>

            <ul class="checkin-list">
                <li>Simples e intuitivo</li>
                <li>Funciona online e offline</li>
                <li>Histórico completo</li>
            </ul>

            <div class="checkin-tags" aria-label="Recursos do check-in">
                <span><i aria-hidden="true"></i>Timer Integrado</span>
                <span><i aria-hidden="true"></i>Metas Diárias</span>
            </div>
        </div>

        <div class="checkin-visual from-right" aria-label="Tela de metrônomo de leitura do aplicativo Atlas">
            <img src={checkInPhone.src} alt="Tela de metrônomo de leitura do Atlas" />
        </div>
    </div>
</section>

<section id="ranking" class="ranking-section" aria-labelledby="ranking-title">
    <div class="ranking-container">
        <div class="ranking-visual from-left" aria-label="Tela de ranking semanal do aplicativo Atlas">
            <img src={rankingPhone.src} alt="Tela de ranking semanal gamificado do Atlas" />
        </div>

        <div class="ranking-copy from-right">
            <span class="ranking-pill"><span aria-hidden="true">🏆</span> Gamificação</span>
            <h2 id="ranking-title">Ranking <span>Gamificado</span></h2>
            <p class="ranking-description">
                Suba no ranking semanal competindo com outros leitores.<br class="desktop-only" />
                Conquiste medalhas e desbloqueie achievements conforme lê mais.
            </p>

            <ul class="ranking-list">
                <li>Rankings semanais e mensais</li>
                <li>Sistema de medalhas e conquistas</li>
                <li>Compare com amigos</li>
            </ul>

            <div class="ranking-tags" aria-label="Recursos da gamificação">
                <span><i aria-hidden="true"></i>Competição Saudável</span>
                <span><i aria-hidden="true"></i>Recompensas</span>
            </div>
        </div>
    </div>
</section>

<section id="chat" class="chat-section" aria-labelledby="chat-title">
    <div class="chat-container">
        <div class="chat-copy from-left">
            <span class="chat-pill"><span aria-hidden="true">💬</span> Comunidade</span>
            <h2 id="chat-title">Chat <span>Literário</span></h2>
            <p class="chat-description">
                Converse com outros leitores, compartilhe recomendações<br class="desktop-only" />
                e descubra novos livros através da comunidade Atlas.
            </p>

            <ul class="chat-list">
                <li>Grupos temáticos por gênero</li>
                <li>Recomendações personalizadas</li>
                <li>Discussões e debates literários</li>
            </ul>

            <div class="chat-tags" aria-label="Recursos da comunidade">
                <span><i aria-hidden="true"></i>Grupos Temáticos</span>
                <span><i aria-hidden="true"></i>Recomendações</span>
            </div>
        </div>

        <div class="chat-visual from-right" aria-label="Tela de chat literário do aplicativo Atlas">
            <img src={chatPhone.src} alt="Tela de chat literário do Atlas" />
        </div>
    </div>
</section>

<section id="companion" class="companion-section" aria-labelledby="companion-title">
    <div class="companion-container">
        <div class="companion-visual from-left" aria-label="Tela do companheiro Atlas">
            <img src={companionPhone.src} alt="Tela do aplicativo Atlas com o mascote urso acompanhando o progresso de leitura" />
        </div>

        <div class="companion-copy from-right">
            <span class="companion-pill"><span aria-hidden="true">🐻</span> Companheiro</span>
            <h2 id="companion-title">Seu Amigo <span>Atlas</span></h2>
            <p class="companion-description">
                O nosso mascote urso te acompanha na jornada literária,<br class="desktop-only" />
                te motiva a cada página lida e celebra suas conquistas.
            </p>

            <ul class="companion-list">
                <li>Motivação personalizada</li>
                <li>Celebra suas conquistas</li>
                <li>Dicas de leitura diárias</li>
            </ul>

            <div class="companion-tags" aria-label="Recursos do companheiro Atlas">
                <span><i aria-hidden="true"></i>Interativo</span>
                <span><i aria-hidden="true"></i>Motivacional</span>
            </div>
        </div>
    </div>
</section>

