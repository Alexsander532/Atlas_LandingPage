        transform-origin: center center;
        will-change: transform;
        animation: companionFloat 6.3s ease-in-out 1.1s infinite;
    }

    .companion-visual:hover img {
        animation-play-state: paused;
        transform: translateY(-10px) rotate(-1deg) scale(1.025);
        transition: transform .45s cubic-bezier(.22, 1, .36, 1), filter .45s ease;
        filter: drop-shadow(0 31px 33px rgba(0, 0, 0, .68));
    }

