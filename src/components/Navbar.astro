---
import atlasLogo from '../../imagens_mockup/atlasLogoPrincipal.png';
---

<header class="site-header" id="navbar">
    <a class="brand" href="#home" aria-label="Atlas, início">
        <img class="brand-logo" src={atlasLogo.src} alt="Atlas" />
    </a>

    <nav class="nav-pills" aria-label="Navegação principal">
        <a class="nav-link is-active" href="#home">Início</a>
        <a class="nav-link" href="#resources">Recursos</a>
        <a class="nav-link" href="#testimonials">Depoimentos</a>
        <a class="nav-link" href="#resources">FAQ</a>
    </nav>

    <div class="nav-actions">
        <a class="language-switch" href="#home" aria-label="Português do Brasil">
            <svg class="language-flag" viewBox="0 0 28 20" aria-hidden="true">
                <rect width="28" height="20" rx="2" fill="#009c3b" />
                <path d="M14 2.25 25.5 10 14 17.75 2.5 10 14 2.25Z" fill="#ffdf00" />
                <circle cx="14" cy="10" r="4.25" fill="#002776" />
                <path d="M10.15 9.05c2.65-.72 5.45-.4 7.65.9" fill="none" stroke="#fff" stroke-width=".7" stroke-linecap="round" />
            </svg>
            BR
        </a>
        <a class="nav-download" href="#resources">Baixar agora</a>
    </div>
</header>

<style>
    .site-header { position: absolute; z-index: 20; top: 0; left: 50%; display: flex; align-items: center; justify-content: space-between; width: min(1370px, calc(100% - 10rem)); padding-top: 2.2rem; transform: translateX(-50%); }
    .brand { display: flex; align-items: center; color: #f7f8fb; animation: header-item-in .7s cubic-bezier(.22, 1, .36, 1) .05s both; }
    .brand-logo { display: block; width: 170px; height: auto; }
    .nav-pills { display: flex; gap: .15rem; padding: .35rem .45rem; border: 1px solid rgba(173, 201, 226, .15); border-radius: 99px; background: rgba(20, 29, 37, .62); box-shadow: inset 0 1px rgba(255,255,255,.04), 0 10px 30px rgba(0,0,0,.13); backdrop-filter: blur(16px); }
    .nav-link { padding: .72rem 1.45rem; border-radius: 99px; color: #bdc8d6; font-size: .95rem; transition: color .2s ease, background .2s ease; animation: header-item-in .7s cubic-bezier(.22, 1, .36, 1) .2s both; }
    .nav-link:nth-child(2) { animation-delay: .28s; }
    .nav-link:nth-child(3) { animation-delay: .36s; }
    .nav-link:nth-child(4) { animation-delay: .44s; }
    .nav-link:hover, .nav-link.is-active { color: #fff; background: rgba(5, 10, 15, .7); }
    .nav-actions { display: flex; align-items: center; gap: 1.4rem; }
    .language-switch { display: flex; align-items: center; gap: .7rem; padding: .82rem 1.3rem; border: 1px solid rgba(173, 201, 226, .13); border-radius: 99px; color: #f1f4f8; font-size: .93rem; background: rgba(14, 20, 26, .38); animation: header-item-in .7s cubic-bezier(.22, 1, .36, 1) .56s both; }
    .language-flag { display: block; width: 23px; height: 16px; flex: 0 0 auto; border-radius: 2px; box-shadow: 0 0 0 1px rgba(255,255,255,.22), 0 3px 8px rgba(0,0,0,.2); }
    .nav-download { padding: .98rem 2.1rem; border-radius: 99px; color: #fff; background: linear-gradient(135deg, #137dec, #168ef9); box-shadow: 0 9px 20px rgba(13, 121, 234, .24); font-size: .95rem; font-weight: 600; transition: transform .2s ease, box-shadow .2s ease; animation: header-item-in .75s cubic-bezier(.22, 1, .36, 1) .66s both; }
    .nav-download:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(13, 121, 234, .38); }

    @keyframes header-item-in {
        from { opacity: 0; filter: blur(5px); }
        to { opacity: 1; filter: blur(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .brand,
        .nav-link,
        .language-switch,
        .nav-download { animation: none; }
    }

    @media (max-width: 1180px) {
        .site-header { width: min(1100px, calc(100% - 4rem)); }
        .nav-link { padding-inline: .85rem; }
        .nav-actions { gap: .6rem; }
        .language-switch { padding-inline: .85rem; }
        .nav-download { padding-inline: 1.25rem; }
    }

    @media (max-width: 900px) {
        .site-header { width: calc(100% - 2rem); padding-top: 1.4rem; }
        .brand-logo { width: 138px; }
        .nav-pills { display: none; }
        .language-switch { display: none; }
        .nav-download { padding: .78rem 1rem; font-size: .8rem; }
    }
</style>
